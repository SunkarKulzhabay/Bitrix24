# Скопируй в .env (в папке C:\Bitrix24) и подставь свои значения.
# Пароль базы: только буквы и цифры, иначе адрес сломается.
DATABASE_URL=postgresql+asyncpg://postgres:ТВОЙ_ПАРОЛЬ@localhost:5432/crm_db

# Длинная случайная строка. Получить:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=вставь_сюда_длинную_строку

ACCESS_TOKEN_MINUTES=480
